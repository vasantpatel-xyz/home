{
  "name": "family-site",
  "private": true,
  "type": "module",
  "description": "family.vasantpatel.xyz — shared household site on Cloudflare Workers + KV, behind Cloudflare Access",
  "scripts": {
    "bundle": "node scripts/bundle-assets.mjs",
